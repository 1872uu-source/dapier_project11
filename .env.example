# Copy to .env at repository root; source it with: set -a; source .env; set +a
# Local ROS domain used by NOMI test setup
ROS_DOMAIN_ID=222
NOMI_MODEL_PROFILE=qwen35_single
OLLAMA_HOST=http://127.0.0.1:11434

# MuJoCo-only server defaults. Navigation stays disabled until explicitly enabled.
ROBOT_TYPE=mujoco
ROBOT_HOST=127.0.0.1
ROBOT_PORT_CMD=5555
ROBOT_PORT_DATA=5556
NOMI_MUJOCO_NAV_ENABLED=0
UI_HOST=127.0.0.1
UI_PORT=8000

# Vite client connection settings
VITE_SERVER_HOST=127.0.0.1
VITE_SERVER_PORT=8000
VITE_SERVER_PROTOCOL=http

# Do not put API keys, tokens, passwords, private IPs, or personal paths here.
