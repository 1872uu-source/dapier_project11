<mujoco model="xlerobot_scene">
  <include file="./xlerobot.xml"/>

  <option timestep="0.002" gravity="0 0 -9.80665" integrator="implicitfast"/>

  <statistic center="0.3 0 0.4" extent="1"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="flat" mark="edge" rgb1="0.1 0.1 0.1" rgb2="0.3 0.5 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>
  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    <!--
      Indoor classroom map. Web/planner coordinates are chassis/map-frame x,y;
      the fixed chassis +90 degree rotation maps them to MuJoCo world (-y,x).
      Room bounds: x=[-5,5], y=[-4,8] m. South doorway is 1.8 m wide.
    -->
    <geom name="room_wall_west" type="box" pos="-2.0 -5.0 0.90" size="6.0 0.12 0.90" rgba="0.82 0.85 0.87 1"/>
    <geom name="room_wall_east" type="box" pos="-2.0 5.0 0.90" size="6.0 0.12 0.90" rgba="0.82 0.85 0.87 1"/>
    <geom name="room_wall_north" type="box" pos="-8.0 0.0 0.90" size="0.12 5.0 0.90" rgba="0.82 0.85 0.87 1"/>
    <geom name="room_wall_south_left" type="box" pos="4.0 -2.95 0.90" size="0.12 2.05 0.90" rgba="0.82 0.85 0.87 1"/>
    <geom name="room_wall_south_right" type="box" pos="4.0 2.95 0.90" size="0.12 2.05 0.90" rgba="0.82 0.85 0.87 1"/>

    <!-- Table collision footprints match indoorMap.ts and pathPlanner.ts. -->
    <geom name="table_1" type="box" pos="-1.10 -2.45 0.38" size="0.45 0.70 0.38" rgba="0.74 0.46 0.24 1" friction="1.0 0.01 0.001"/>
    <geom name="table_2" type="box" pos="-3.00 0.00 0.38" size="0.45 0.70 0.38" rgba="0.28 0.48 0.66 1" friction="1.0 0.01 0.001"/>
    <geom name="table_3" type="box" pos="-1.10 2.45 0.38" size="0.45 0.70 0.38" rgba="0.39 0.53 0.36 1" friction="1.0 0.01 0.001"/>
    <geom name="charging_marker" type="cylinder" pos="-6.8 -3.8 0.03" size="0.32 0.03" rgba="0.20 0.75 0.50 0.75" contype="0" conaffinity="0"/>
  </worldbody>
</mujoco>
